# the tender's own runtime (readings, journal, inner voice, merkle seals, maps)
shelf/

# the sealed kernel's own state (living memory, ledger, grown weights, strata)
memory/
ledger/
weights/
strata/

# python + os noise
__pycache__/
*.pyc
*.pyo
.DS_Store
Thumbs.db
desktop.ini

# scratch
*.tmp
.heart*
